# Copy to .env (not committed) and restart Metro after a change.
# The website API the app reads (/api/v1). The iOS simulator and the web build both reach the
# Mac's localhost, so the local website works there. A phone can't reach localhost: use the live
# address. Cloud builds and updates don't read this file: they use the EAS environment variables
# (eas env:list --environment production). To fill .env from EAS: eas env:pull --environment development
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
